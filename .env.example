# Environment Configuration Example
# Copy to .env for local development. NEVER commit .env to version control!

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-api

# API URL
VITE_API_BASE_URL=http://localhost:8787

# Cloudflare R2 Configuration (Used by Workers API & Tools)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=movie-streaming-bucket
R2_PUBLIC_DOMAIN=https://media.your-domain.com

# Media Pipeline Configuration
LOCAL_MEDIA_INPUT_DIR=./tools/media/input
LOCAL_MEDIA_OUTPUT_DIR=./tools/media/output
FFMPEG_PATH=ffmpeg
